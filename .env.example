# Copy to .env and fill in local values. Never commit .env.

# --- Postgres (docker-compose: postgres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# --- Azurite (Azure Blob Storage emulator, docker-compose: azurite) ---
AZURITE_BLOB_PORT=
AZURITE_QUEUE_PORT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# --- API (apps/api) ---
API_HOST=
API_PORT=
API_LOG_LEVEL=

# --- Web (apps/web) ---
VITE_API_BASE_URL=

# --- Auth / secrets (placeholders — no real values, ever) ---
JWT_SIGNING_KEY=

# --- Authentication foundation (IAM-013, IAM-016) ---
# BREACH_CHECKER_PROVIDER=local is dev/test only, no network call - see
# apps/api/src/api/auth/breach_check.py. Production must set "hibp".
# Sessions use opaque random tokens (hashed at rest), not a shared signing
# secret, so there is no SESSION_SECRET to set here - see ADR-005.
BREACH_CHECKER_PROVIDER=
SESSION_MAX_LIFETIME_HOURS=
SESSION_IDLE_TIMEOUT_MINUTES_PRIVILEGED=

# --- Google sign-in (IAM-010a, IAM-010b) ---
# Scopes requested are fixed in code (openid, email, profile only - see
# apps/api/src/api/auth/google_oidc.py) and are not configurable here by
# design; nothing below should ever change that.
#
# All three unset (the default) means the Google button answers a clean
# 503 errors.google_signin_unavailable; nothing here can be generated locally.
# To enable it, register an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials with this EXACT authorized
# redirect URI, and put the same value in GOOGLE_REDIRECT_URI:
#
#   local:       http://localhost:5173/
#   production:  https://<your web app origin>/
#
# The contract: Google redirects the browser to GOOGLE_REDIRECT_URI with
# ?code&state; the web app (apps/web, App.tsx's readGoogleCallbackParams)
# reads them off its own root and POSTs them to /v1/auth/login/google/callback,
# so the URI is the web app's origin with a trailing slash, not an API path.
# Google compares it byte for byte at both legs (authorization and token
# exchange); a trailing-slash or scheme mismatch is "redirect_uri_mismatch".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- E-mail verification (IAM-010b) ---
# APP_BASE_URL is where links in e-mails point: the verification mail links
# to {APP_BASE_URL}/verify-email?token=..., which the web app turns into
# POST /v1/auth/verify-email. Defaults to http://localhost:5173.
# EXPOSE_DEV_OUTBOX=true registers GET /v1/dev/outbox, returning what the
# collecting e-mail sender would have sent (the verification link, in local
# development, without a mailbox). The route does not exist unless this is
# true, and it must never be true outside local development.
APP_BASE_URL=
EXPOSE_DEV_OUTBOX=

# --- WebAuthn passkeys (IAM-010) ---
# webauthn_rp_id must be a registrable domain suffix of every origin
# passkeys are used from (a bare domain, e.g. "ledgr.nl" - not a URL).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=

# --- Tenant isolation test harness (apps/api/tests/integration, IAM-005) ---
# Test-only. TEST_DATABASE_ADMIN_URL is a superuser connection used solely
# by apps/api/scripts/bootstrap_test_db.py to apply migrations and set
# ledgr_app's test password — never used by the app or by seed helpers.
# DATABASE_URL above must point at the same database, as ledgr_app, once
# bootstrapped. TENANT_ISOLATION_TESTS_ENABLED=1 is the explicit opt-in that
# lets the integration suite run instead of skipping.
TEST_DATABASE_ADMIN_URL=
TEST_LEDGR_APP_PASSWORD=
TENANT_ISOLATION_TESTS_ENABLED=

# --- Envelope encryption (SEC-022, IAM-004, SEC-023) ---
# KMS_PROVIDER=local is dev/test only (see apps/api/src/api/crypto/kms.py).
# Production must set KMS_PROVIDER=azure-key-vault with the two Azure vars
# below; the app authenticates to Key Vault via managed identity, not a
# secret, so no credential belongs here.
KMS_PROVIDER=
LOCAL_DEV_KEK=
AZURE_KEY_VAULT_URL=
AZURE_KEK_NAME=

# ledgr_ops connection, for the scheduled batch jobs in apps/api/scripts/ that
# legitimately need cross-tenant access: SEC-023 key rotation and re-wrap, and
# the NFR-033 nightly ledger integrity sweep. Never used by the running API.
OPS_DATABASE_URL=

# --- Automatic invoice reading (FR-EXP-001c, FR-AP-002, ADR-081) ---
# Off unless a deployment turns it on: reading sends the invoice to a model, and
# PRIV-010/011 keep every sub-processor inside the EU. "vertex-claude" is Claude on
# Google Vertex AI in an EU region; it authenticates with the same Google Cloud
# service account as Cloud KMS (GOOGLE_APPLICATION_CREDENTIALS) and needs the
# Vertex AI API enabled and access to the model in that project and region.
# See docs/decisions/ADR-081-automatic-invoice-reading.md, "Before it is enabled".
EXTRACTION_PROVIDER=none
EXTRACTION_GCP_PROJECT=
EXTRACTION_GCP_REGION=europe-west4
EXTRACTION_MODEL=claude-haiku-4-5@20251001
EXTRACTION_TIMEOUT_SECONDS=30

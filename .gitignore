# Env
.env

# A GCP service-account key downloaded straight into the repo root (IAM &
# Admin -> Keys) is a real credential, not something to gitignore-and-forget -
# move it out of the repo. This is a safety net only.
project-7a7785ad-6667-4be9-ad4-*.json
*-service-account*.json

# Local dev infrastructure (native Postgres/Azurite installed in place of
# Docker, which is absent on this machine — see the "local dev stack" memory
# note). Binaries, a real database cluster, and generated credentials; none
# of it belongs in the repo.
.devtools/

# `railway config pull`'s snapshot of the live project, generated while
# diagnosing why preDeployCommand wasn't running. The project still deploys
# from railway.json (Config as Code) — switching to this Infrastructure as
# Code format is a separate decision, not something to commit as a side
# effect of a diagnostic pull.
.railway/

# Agent skills installed with `npx skills add`. These configure whoever is
# working on the repo, not the repo itself — a different person may want a
# different set, and they run with full agent permissions, so they are not
# something to inherit silently by cloning. `.claude/skills/` rather than
# `.claude/`, so project-level Claude settings can still be tracked later.
.agents/
.claude/skills/
skills-lock.json

# Node
node_modules/
dist/
coverage/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# Hypothesis's example database: failing cases it found, cached to replay
# first on the next run. Machine-local and regenerated; the reproducibility
# that matters across machines comes from derandomize=True in
# tests/ledger/test_properties.py.
.hypothesis/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artefacts of tsc -b / vitest
*.tsbuildinfo
apps/web/vite.config.js
apps/web/vite.config.d.ts
apps/api/pytest_debug.txt


# Playwright golden path (apps/web/e2e): run artefacts, not source.
apps/web/e2e/.results/
apps/web/e2e/screenshots/
